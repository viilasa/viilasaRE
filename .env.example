# Copy to `.env.local` — never commit real secrets.

NEXT_PUBLIC_SITE_URL=https://viilasa.com

# Contact (defaults to surya@viilasa.com in code — set to override branded inboxes later)
NEXT_PUBLIC_CONTACT_EMAIL=surya@viilasa.com

# Cal.com scheduling — default in code is https://cal.com/viilasa; set to override (e.g. a specific event slug).
# NEXT_PUBLIC_CAL_BOOKING_URL=https://cal.com/viilasa/strategy-call
NEXT_PUBLIC_CAL_BOOKING_URL=https://cal.com/viilasa

# ═══════════════════════════════════════════════════════════
# Cal.com API (server-only — do NOT use NEXT_PUBLIC_ prefix)
# Used for server-side integrations (REST API, webhooks), not for “Book a call” buttons.
# Create in: https://app.cal.com/settings/developer/api-keys
# CAL_COM_API_KEY=

# WhatsApp (+91 …8668968265 baked in code as fallback — override in Vercel if needed)
# Full link wins over phone if both set:
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/918668968265?text=Hi%20Viilasa
NEXT_PUBLIC_WHATSAPP_PHONE=918668968265


# ── SEO / sharing (recommended in production)
# Google Search Console → HTML tag verification value only (not the whole tag):
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_TWITTER_HANDLE=viilasa
