# Copy to .env.local — never commit real secrets here

NEXT_PUBLIC_SITE_URL=https://viilasa.com

# Cal.com (or compatible) scheduling link
NEXT_PUBLIC_CAL_BOOKING_URL=https://cal.com/your-handle/viilasa

# Prefer a full WhatsApp deep link …
NEXT_PUBLIC_WHATSAPP_URL=

# …or digits only (country code included, no +) to auto-build wa.me:
# NEXT_PUBLIC_WHATSAPP_PHONE=9715XXXXXXXX

# ── SEO / sharing (recommended in production)
# Google Search Console → HTML tag verification value only (not the whole tag):
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_TWITTER_HANDLE=viilasa
